# Copy to .env and update for your environment. Never commit production secrets.
DJANGO_SECRET_KEY=replace-with-your-own-long-random-value
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Production: ALLOWED_HOSTS=YOUR_USERNAME.pythonanywhere.com
# Production: CSRF_TRUSTED_ORIGINS=https://YOUR_USERNAME.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=
# Set to your operating region (e.g. Asia/Kolkata or Asia/Muscat)
TIME_ZONE=Asia/Kolkata
# Add ONE provider key; Gemini is tried first, Hugging Face is backup.
# See README.md for setup.
HF_API_KEY=
HF_MODEL=openai/gpt-oss-120b:fastest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: admin-approved manual transfer instructions for advance requests.
# Example (replace with real business details): Pay to the official ServiGo account and enter the transfer reference.
# No card data is collected, and no money is processed by the app.
ADVANCE_PAYMENT_INSTRUCTIONS=

# Razorpay Standard Checkout — use rzp_test_* keys for academic demo (no real money).
# Live mode requires Razorpay merchant KYC/activation; transaction fees may apply.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
